{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*",
			"!test/fixtures/**/*",
			"!pnpm-lock.yaml",
			"!CHANGELOG.md"
		]
	},
	"markdown": {
		"parser": {
			"frontmatter": true
		}
	}
}
